    "/cupones": {
      "get": {
        "tags": [
          "Consulta"
        ],
        "operationId": "listarCupones",
        "summary": "Consultar cupones y estados del grupo",
        "description": "Grupo derivado de X-API-Key. Orden ascendente por UUID id. Filtros opcionales combinados. total cuenta filas filtradas. Lista vacía devuelve 200. Estado disponible puede incluir vencidos: consultar fecha_vencimiento. No admite filtros desconocidos ni repetidos. La aplicación consumidora debe autorizar a su gerente.",
        "parameters": [
          {
            "name": "estado",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "disponible",
                "medico",
                "paciente",
                "usado"
              ]
            },
            "description": "Omitir para consultar todos los estados."
          },
          {
            "name": "medico_id",
            "in": "query",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
            },
            "description": "Filtro dentro del grupo autenticado; no autentica al actor."
          },
          {
            "name": "gerente_id",
            "in": "query",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
            },
            "description": "Filtro dentro del grupo autenticado; no autentica al actor."
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 20,
              "minimum": 1,
              "maximum": 100
            }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 0,
              "minimum": 0,
              "maximum": 1000000
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Página del grupo autenticado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Listado"
                },
                "example": {
                  "items": [],
                  "total": 0,
                  "limit": 20,
                  "offset": 0
                }
              }
            }
          },
          "400": {
            "description": "Solicitud inválida, campos desconocidos, p_grupo_id enviado por el cliente, cupón vencido o estado no habilitado. Ver reglas de la operación.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "code": "HTTP400",
                  "message": "Campos incorrectos. No envíes p_grupo_id.",
                  "details": null,
                  "hint": null
                }
              }
            }
          },
          "401": {
            "description": "X-API-Key ausente, inválida o revocada.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
