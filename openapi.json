    "/generar_cupones_gerencia": {
      "post": {
        "tags": [
          "Operaciones"
        ],
        "operationId": "generar_cupones_gerencia",
        "summary": "Generar lote",
        "description": "Crea entre 1 y 1000 cupones disponibles. Un gerente por grupo. Vencimiento automático a 30 días según CURRENT_DATE de PostgreSQL. Descuento positivo; el SQL actual no limita a 100. Repetir la solicitud crea otro lote.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/generar_cupones_gerencia_entrada"
              },
              "example": {
                "p_gerente_id": "G-1234",
                "p_cantidad": 2,
                "p_porcentaje_descuento": 20
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Operación realizada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Generados"
                },
                "example": [
                  {
                    "codigo_cupon": "8a4b2c9f",
                    "porcentaje": 20
                  },
                  {
                    "codigo_cupon": "1d9e4f2a",
                    "porcentaje": 20
                  }
                ]
              }
            }
          },
          "400": {
            "description": "Solicitud inválida, campos desconocidos, p_grupo_id enviado por el cliente, cupón vencido o estado no habilitado. Ver reglas de la operación.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "code": "HTTP400",
                  "message": "Campos incorrectos. No envíes p_grupo_id.",
                  "details": null,
                  "hint": null
                }
              }
            }
          },
          "401": {
            "description": "X-API-Key ausente, inválida o revocada.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
